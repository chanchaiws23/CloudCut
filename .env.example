# Docker Compose deployment settings
POSTGRES_USER=cloudcut
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=cloudcut

# Use your public frontend origin when deployed behind a domain.
FRONTEND_URL=https://cloudcut.example.com

# Use long random strings in production.
JWT_SECRET=change-this-jwt-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# auto seeds demo data only when the database is empty.
# true forces reseeding and resets demo data on startup; false disables seeding.
SEED_DATABASE=auto

# Frontend build-time API URL. Keep /api when using the bundled nginx proxy.
VITE_API_URL=/api

# Optional Pusher realtime settings.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# Optional S3/R2 asset storage. Leave blank to use local Docker volumes.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
